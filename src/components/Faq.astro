---
import siteContent from '../data/siteContent.json';
const { faq } = siteContent;
---

<section id="faq" class="py-20 md:py-28 relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1224] border border-[#0052FF]/30 text-xs font-mono-code text-[#00F0FF] mb-4">
        <span>?</span>
        <span>{faq.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {faq.title}
      </h2>
      <p class="text-base text-slate-300/90 leading-relaxed">
        {faq.subtitle}
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {faq.items.map((item, index) => (
        <details class="group rounded-2xl bg-[#090e1c]/80 border border-white/[0.08] transition-all duration-300 hover:border-white/20 open:bg-[#0d1527] open:border-[#0052FF]/40 open:shadow-[0_0_30px_rgba(0,82,255,0.15)]">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none focus:outline-none">
            <span class="text-base sm:text-lg font-bold text-white group-open:text-[#00F0FF] transition-colors pr-4">
              {item.q}
            </span>
            <div class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex-shrink-0 flex items-center justify-center text-slate-300 group-hover:text-white group-open:bg-[#0052FF] group-open:text-white group-open:border-[#0052FF] transition-all duration-300">
              <svg class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 pt-1 text-sm sm:text-base text-slate-300/90 leading-relaxed border-t border-white/[0.04]">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

