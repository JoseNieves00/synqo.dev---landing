---
import siteContent from '../data/siteContent.json';
const { hero } = siteContent;
---

<section class="relative pt-36 pb-20 md:pt-44 md:pb-32 overflow-hidden flex flex-col items-center justify-center text-center px-4 sm:px-6 lg:px-8">
  
  <!-- Ambient background glow behind Hero -->
  <div class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[600px] h-[300px] bg-[#0052FF]/20 rounded-full blur-[120px] -z-10"></div>
  <div class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/3 -translate-y-1/2 w-[250px] sm:w-[450px] h-[250px] bg-[#00F0FF]/15 rounded-full blur-[100px] -z-10"></div>

  <div class="max-w-4xl mx-auto flex flex-col items-center">
    
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0d1527]/90 border border-white/[0.12] shadow-[0_0_20px_rgba(0,82,255,0.2)] mb-8 transition-transform hover:scale-[1.02]">
      <span class="w-1.5 h-1.5 rounded-full bg-[#00F0FF] shadow-[0_0_8px_#00F0FF]"></span>
      <span class="text-xs sm:text-[13px] font-mono-code font-medium tracking-wider text-slate-300">
        {hero.eyebrow}
      </span>
    </div>

    <!-- H1 Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] sm:leading-[1.12] mb-6">
      {hero.h1Prefix}{' '}
      <span class="text-gradient-cyan block sm:inline mt-1 sm:mt-0">
        {hero.h1Highlight}
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl text-slate-300/95 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
      {hero.subtitle}
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-14">
      <!-- Primary CTA -->
      <a 
        href={hero.primaryCta.href}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-bold text-white bg-[#0052FF] hover:bg-[#0041cb] shadow-[0_0_30px_rgba(0,82,255,0.45)] hover:shadow-[0_0_40px_rgba(0,82,255,0.7)] transition-all duration-300 hover:-translate-y-1 group"
      >
        <span>{hero.primaryCta.label}</span>
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <!-- Secondary CTA -->
      <a 
        href={hero.secondaryCta.href}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-semibold text-slate-200 bg-[#0d1527]/80 hover:bg-[#121d36] border border-white/10 hover:border-[#00F0FF]/40 transition-all duration-300 hover:-translate-y-0.5 group"
      >
        <span>{hero.secondaryCta.label}</span>
        <svg class="w-4 h-4 text-[#00F0FF] transition-transform duration-200 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>

    <!-- Technical Proof / Performance Badge -->
    <div class="w-full max-w-2xl px-4 py-3 rounded-2xl bg-[#090e1c]/80 border border-white/[0.08] backdrop-blur-sm shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
      <div class="flex flex-col sm:flex-row items-center justify-around gap-3 sm:gap-2 text-xs sm:text-[13px] font-mono-code text-slate-300 divide-y sm:divide-y-0 sm:divide-x divide-white/[0.08]">
        {hero.performanceBadge.map((badge) => (
          <div class="flex items-center gap-2 py-1 sm:py-0 sm:px-4 w-full sm:w-auto justify-center">
            <span class="text-base">{badge.icon}</span>
            <span class="font-medium tracking-wide text-white/90">{badge.text}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

