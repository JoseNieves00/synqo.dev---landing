---
import siteContent from '../data/siteContent.json';
const { comparison } = siteContent;
---

<section id="comparativa" class="py-20 md:py-28 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1224] border border-[#00F0FF]/20 text-xs font-mono-code text-[#00F0FF] mb-4">
        <span>●</span>
        <span>{comparison.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {comparison.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300/90 leading-relaxed">
        {comparison.subtitle}
      </p>
    </div>

    <!-- Comparison Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- Column 1: El Modelo Tradicional (Otras Agencias) -->
      <div class="rounded-3xl bg-[#090e1c]/60 border border-red-500/15 p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden backdrop-blur-sm">
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-red-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <div>
          <!-- Column Header -->
          <div class="flex items-center justify-between pb-6 mb-8 border-b border-white/[0.06]">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-200">El Modelo Tradicional</h3>
                <span class="text-xs text-red-400/80 font-mono-code">Otras Agencias / Plantillas</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-md bg-red-500/10 text-red-400 text-xs font-mono-code font-medium">Obsoleto</span>
          </div>

          <!-- Points List -->
          <div class="space-y-6">
            {comparison.points.map((pt) => (
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/[0.04]">
                <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 text-xs">
                  ✕
                </div>
                <div>
                  <h4 class="text-base font-semibold text-slate-200 mb-1">{pt.traditional.title}</h4>
                  <p class="text-sm text-slate-400 leading-relaxed">{pt.traditional.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-white/[0.04] text-xs font-mono-code text-slate-400 text-center">
          Resultado: Fuga de prospectos, pauta desperdiciada y fricción operativa.
        </div>
      </div>

      <!-- Column 2: El Estándar Synqo (synqo.dev) -->
      <div class="rounded-3xl bg-[#0d1527]/90 border border-[#0052FF]/40 p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden backdrop-blur-md shadow-[0_0_50px_rgba(0,82,255,0.18)]">
        <!-- Glow accents -->
        <div class="absolute -top-24 -right-24 w-60 h-60 bg-[#00F0FF]/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-60 h-60 bg-[#0052FF]/20 rounded-full blur-3xl pointer-events-none"></div>

        <div>
          <!-- Column Header -->
          <div class="flex items-center justify-between pb-6 mb-8 border-b border-white/[0.08]">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#0052FF]/20 border border-[#00F0FF]/40 flex items-center justify-center text-[#00F0FF] shadow-[0_0_15px_rgba(0,240,255,0.3)]">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white">El Estándar Synqo</h3>
                <span class="text-xs text-[#00F0FF] font-mono-code">synqo.dev · Conversión Activa</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-md bg-[#0052FF]/30 text-[#00F0FF] border border-[#00F0FF]/30 text-xs font-mono-code font-semibold tracking-wide">
              Alto Rendimiento
            </span>
          </div>

          <!-- Points List -->
          <div class="space-y-6">
            {comparison.points.map((pt) => (
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-[#090e1c]/80 border border-white/[0.08] hover:border-[#00F0FF]/30 transition-colors duration-200">
                <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-[#10B981]/15 border border-[#10B981]/30 flex items-center justify-center text-[#10B981] text-xs font-bold">
                  ✓
                </div>
                <div>
                  <h4 class="text-base font-semibold text-white mb-1 flex items-center gap-2">
                    {pt.synqo.title}
                  </h4>
                  <p class="text-sm text-slate-300/90 leading-relaxed">{pt.synqo.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-white/[0.08] text-xs font-mono-code text-[#00F0FF] text-center flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#00F0FF] animate-pulse"></span>
          Resultado: Cero rebote técnico + captura y agendamiento 24/7.
        </div>
      </div>

    </div>

  </div>
</section>
