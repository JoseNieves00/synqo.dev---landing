---
import siteContent from '../data/siteContent.json';
const { niches } = siteContent;
---

<section class="py-20 md:py-28 relative overflow-hidden bg-[#090e1c]/40 border-y border-white/[0.05]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1224] border border-[#00F0FF]/30 text-xs font-mono-code text-[#00F0FF] mb-4">
        <span>🎯</span>
        <span>{niches.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {niches.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300/90 leading-relaxed">
        {niches.subtitle}
      </p>
    </div>

    <!-- Niches Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {niches.items.map((item, index) => (
        <div class="group rounded-2xl bg-[#0c1322] border border-white/[0.08] hover:border-[#0052FF]/60 p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(0,82,255,0.15)] relative overflow-hidden">
          
          <!-- Subtle top corner glow on hover -->
          <div class="absolute -top-12 -right-12 w-24 h-24 bg-[#00F0FF]/10 rounded-full blur-xl group-hover:bg-[#00F0FF]/20 transition-all duration-300 pointer-events-none"></div>

          <div>
            <!-- Icon & Number -->
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-xl bg-[#090e1c] border border-white/10 flex items-center justify-center text-[#00F0FF] text-xl group-hover:scale-110 group-hover:border-[#00F0FF]/40 transition-all duration-300">
                {index === 0 && '🩺'}
                {index === 1 && '⚖️'}
                {index === 2 && '🛠️'}
                {index === 3 && '💼'}
              </div>
              <span class="text-xs font-mono-code text-slate-400 group-hover:text-slate-300">
                0{index + 1}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-[#00F0FF] transition-colors">
              {item.industry}
            </h3>

            <!-- Examples -->
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">
              {item.examples}
            </p>
          </div>

          <!-- Bottom Action Badge -->
          <div class="pt-4 border-t border-white/[0.06] flex flex-col gap-1.5">
            <span class="text-[11px] font-mono-code text-slate-400 uppercase tracking-wider">
              Solución clave:
            </span>
            <span class="text-xs font-semibold text-[#10B981] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
              {item.action}
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
