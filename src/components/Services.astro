---
import siteContent from '../data/siteContent.json';
const { servicesCatalog } = siteContent;
---

<section id="servicios" class="py-20 md:py-32 relative overflow-hidden">
  
  <!-- Ambient background glow for featured card -->
  <div class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-[#0052FF]/10 rounded-full blur-[160px] -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1224] border border-[#0052FF]/30 text-xs font-mono-code text-[#00F0FF] mb-4">
        <span>★</span>
        <span>{servicesCatalog.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {servicesCatalog.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300/90 leading-relaxed">
        {servicesCatalog.subtitle}
      </p>
    </div>

    <!-- Minimalist Category Switcher / Navigation Tabs -->
    <div class="flex items-center justify-center mb-12">
      <div class="inline-flex flex-wrap items-center justify-center gap-2 p-1.5 rounded-2xl bg-[#090e1c] border border-white/[0.08] backdrop-blur-md">
        {servicesCatalog.categories.map((cat, index) => (
          <button
            type="button"
            data-category-target={cat.id}
            class={`catalog-tab-btn px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer flex items-center gap-2 ${
              index === 0
                ? 'bg-[#0052FF] text-white shadow-[0_0_20px_rgba(0,82,255,0.4)] active-category'
                : 'text-slate-400 hover:text-white hover:bg-white/[0.04]'
            }`}
          >
            <span>{cat.label}</span>
            {cat.badge && (
              <span class={`hidden sm:inline text-[10px] font-mono-code px-1.5 py-0.5 rounded ${
                index === 0 ? 'bg-white/20 text-white' : 'bg-white/[0.06] text-slate-400'
              }`}>
                {cat.badge}
              </span>
            )}
          </button>
        ))}
      </div>
    </div>

    <!-- Category 1: Combos Todo Incluido (Web + CRM) -->
    <div id="category-panel-combos" class="catalog-panel">
      <div class="mb-8 text-center max-w-2xl mx-auto">
        <p class="text-sm sm:text-base text-slate-300 font-mono-code">
          {servicesCatalog.categories[0].tagline}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        {servicesCatalog.combos.map((plan) => (
          <div class={`rounded-3xl flex flex-col justify-between transition-all duration-300 relative ${
            plan.featured 
              ? 'bg-[#0d1527] border-2 border-[#0052FF] shadow-[0_0_40px_rgba(0,82,255,0.3)] lg:-translate-y-3 p-8' 
              : 'bg-[#090e1c]/80 border border-white/[0.08] hover:border-white/20 p-7'
          }`}>
            
            {plan.featured && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-[#0052FF] to-[#00F0FF] text-[11px] font-mono-code font-bold text-white shadow-md uppercase tracking-wider flex items-center gap-1.5">
                <span>⚡</span> {plan.level}
              </div>
            )}

            <div>
              <div class="mb-5">
                {!plan.featured && (
                  <span class="inline-block px-2.5 py-1 rounded-md bg-[#0052FF]/15 border border-[#0052FF]/30 text-[#00F0FF] text-[11px] font-mono-code font-semibold mb-3">
                    {plan.level}
                  </span>
                )}
                <h3 class={`text-xl sm:text-2xl font-bold text-white ${plan.featured ? 'mt-2' : ''}`}>
                  {plan.name}
                </h3>
                <p class="text-xs sm:text-sm text-slate-400 mt-2 leading-relaxed">
                  {plan.target}
                </p>
              </div>

              <!-- Features List -->
              <div class="space-y-3 pt-4 border-t border-white/[0.06] mb-8">
                <span class="text-xs font-mono-code uppercase tracking-wider text-slate-400 block mb-2">
                  Ecosistema incluido:
                </span>
                {plan.features.map((feature) => (
                  <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-200">
                    <span class={`mt-0.5 flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold ${
                      plan.featured 
                        ? 'bg-[#00F0FF]/20 text-[#00F0FF]' 
                        : 'bg-[#0052FF]/20 text-[#0052FF]'
                    }`}>
                      ✓
                    </span>
                    <span class="leading-relaxed">{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pt-4 border-t border-white/[0.06]">
              <a 
                href="#diagnostico" 
                class={`w-full py-3.5 rounded-xl text-center text-sm font-bold block transition-all duration-200 cursor-pointer ${
                  plan.featured
                    ? 'bg-[#0052FF] hover:bg-[#0041cb] text-white shadow-[0_0_25px_rgba(0,82,255,0.5)]'
                    : 'bg-white/5 hover:bg-white/10 text-white border border-white/10'
                }`}
              >
                {plan.cta}
              </a>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Category 2: Software CRM + IA Solo (High Ticket Spotlight) -->
    <div id="category-panel-crm" class="catalog-panel hidden">
      <div class="mb-8 text-center max-w-2xl mx-auto">
        <p class="text-sm sm:text-base text-slate-300 font-mono-code">
          {servicesCatalog.categories[1].tagline}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        {servicesCatalog.crmPlans.map((plan) => (
          <div class={`rounded-3xl flex flex-col justify-between transition-all duration-300 relative ${
            plan.featured 
              ? 'bg-[#0d1527] border-2 border-[#0052FF] shadow-[0_0_40px_rgba(0,82,255,0.35)] lg:-translate-y-3 p-8' 
              : 'bg-[#090e1c]/80 border border-white/[0.08] hover:border-white/20 p-7'
          }`}>
            
            {plan.featured && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-[#0052FF] to-[#00F0FF] text-[11px] font-mono-code font-bold text-white shadow-md uppercase tracking-wider flex items-center gap-1.5">
                <span>🤖</span> {plan.level}
              </div>
            )}

            <div>
              <div class="mb-5">
                {!plan.featured && (
                  <span class="inline-block px-2.5 py-1 rounded-md bg-[#00F0FF]/15 border border-[#00F0FF]/30 text-[#00F0FF] text-[11px] font-mono-code font-semibold mb-3">
                    {plan.level}
                  </span>
                )}
                <h3 class={`text-xl sm:text-2xl font-bold text-white ${plan.featured ? 'mt-2' : ''}`}>
                  {plan.name}
                </h3>
                <p class="text-xs sm:text-sm text-slate-400 mt-2 leading-relaxed">
                  {plan.target}
                </p>
              </div>

              <!-- Features List -->
              <div class="space-y-3 pt-4 border-t border-white/[0.06] mb-8">
                <span class="text-xs font-mono-code uppercase tracking-wider text-slate-400 block mb-2">
                  Capacidades del CRM:
                </span>
                {plan.features.map((feature) => (
                  <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-200">
                    <span class={`mt-0.5 flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold ${
                      plan.featured 
                        ? 'bg-[#00F0FF]/20 text-[#00F0FF]' 
                        : 'bg-[#0052FF]/20 text-[#0052FF]'
                    }`}>
                      ✓
                    </span>
                    <span class="leading-relaxed">{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pt-4 border-t border-white/[0.06]">
              <a 
                href="#diagnostico" 
                class={`w-full py-3.5 rounded-xl text-center text-sm font-bold block transition-all duration-200 cursor-pointer ${
                  plan.featured
                    ? 'bg-[#0052FF] hover:bg-[#0041cb] text-white shadow-[0_0_25px_rgba(0,82,255,0.5)]'
                    : 'bg-white/5 hover:bg-white/10 text-white border border-white/10'
                }`}
              >
                {plan.cta}
              </a>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Category 3: Desarrollo Web & Landings Solo -->
    <div id="category-panel-web" class="catalog-panel hidden">
      <div class="mb-8 text-center max-w-2xl mx-auto">
        <p class="text-sm sm:text-base text-slate-300 font-mono-code">
          {servicesCatalog.categories[2].tagline}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto items-stretch">
        {servicesCatalog.webServices.map((plan) => (
          <div class={`rounded-3xl flex flex-col justify-between transition-all duration-300 relative ${
            plan.featured 
              ? 'bg-[#0d1527] border-2 border-[#0052FF] shadow-[0_0_35px_rgba(0,82,255,0.25)] p-8' 
              : 'bg-[#090e1c]/80 border border-white/[0.08] hover:border-white/20 p-8'
          }`}>
            
            <div>
              <div class="mb-6">
                <span class="inline-block px-2.5 py-1 rounded-md bg-[#0052FF]/15 border border-[#0052FF]/30 text-[#00F0FF] text-[11px] font-mono-code font-semibold mb-3">
                  {plan.level}
                </span>
                <h3 class="text-2xl font-bold text-white">
                  {plan.name}
                </h3>
                <p class="text-xs sm:text-sm text-slate-400 mt-2 leading-relaxed">
                  {plan.target}
                </p>
              </div>

              <!-- Features List -->
              <div class="space-y-3 pt-4 border-t border-white/[0.06] mb-8">
                <span class="text-xs font-mono-code uppercase tracking-wider text-slate-400 block mb-2">
                  Especificaciones técnicas:
                </span>
                {plan.features.map((feature) => (
                  <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-200">
                    <span class="mt-0.5 flex-shrink-0 w-4 h-4 rounded-full bg-[#10B981]/20 text-[#10B981] flex items-center justify-center text-[10px] font-bold">
                      ✓
                    </span>
                    <span class="leading-relaxed">{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pt-4 border-t border-white/[0.06]">
              <a 
                href="#diagnostico" 
                class="w-full py-3.5 rounded-xl text-center text-sm font-bold block bg-[#0052FF] hover:bg-[#0041cb] text-white shadow-md transition-all duration-200"
              >
                {plan.cta}
              </a>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Category 4: Módulos & Escalabilidad (Addons) -->
    <div id="category-panel-addons" class="catalog-panel hidden">
      <div class="mb-8 text-center max-w-2xl mx-auto">
        <p class="text-sm sm:text-base text-slate-300 font-mono-code">
          {servicesCatalog.categories[3].tagline}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {servicesCatalog.addons.map((add) => (
          <div class="p-6 rounded-2xl bg-[#090e1c]/90 border border-white/[0.08] flex flex-col justify-between hover:border-[#00F0FF]/40 transition-all duration-300">
            <div>
              <span class="inline-block px-2 py-0.5 rounded text-[10px] font-mono-code bg-[#00F0FF]/10 text-[#00F0FF] border border-[#00F0FF]/20 mb-3">
                {add.badge}
              </span>
              <h3 class="text-base font-bold text-white mb-2">{add.name}</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                {add.description}
              </p>
            </div>
            <div class="pt-3 border-t border-white/[0.05]">
              <span class="text-[11px] font-mono-code text-slate-400 block">
                {add.detail}
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Addon CTA Note -->
      <div class="mt-8 text-center">
        <a 
          href="#diagnostico" 
          class="inline-flex items-center gap-2 text-xs font-mono-code text-[#00F0FF] hover:underline"
        >
          <span>¿Necesitas una arquitectura a medida para tu empresa? Contáctanos para asesorarte</span>
          <span>→</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll('.catalog-tab-btn');
  const panels = document.querySelectorAll('.catalog-panel');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.getAttribute('data-category-target');

      // Reset buttons
      tabButtons.forEach((b) => {
        b.classList.remove('bg-[#0052FF]', 'text-white', 'shadow-[0_0_20px_rgba(0,82,255,0.4)]', 'active-category');
        b.classList.add('text-slate-400');
        const badge = b.querySelector('span:nth-child(2)');
        if (badge) {
          badge.classList.remove('bg-white/20', 'text-white');
          badge.classList.add('bg-white/[0.06]', 'text-slate-400');
        }
      });

      // Activate clicked button
      btn.classList.add('bg-[#0052FF]', 'text-white', 'shadow-[0_0_20px_rgba(0,82,255,0.4)]', 'active-category');
      btn.classList.remove('text-slate-400');
      const activeBadge = btn.querySelector('span:nth-child(2)');
      if (activeBadge) {
        activeBadge.classList.add('bg-white/20', 'text-white');
        activeBadge.classList.remove('bg-white/[0.06]', 'text-slate-400');
      }

      // Show matching panel
      panels.forEach((p) => {
        if (p.id === `category-panel-${targetCat}`) {
          p.classList.remove('hidden');
        } else {
          p.classList.add('hidden');
        }
      });
    });
  });
</script>
