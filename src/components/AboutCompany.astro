---
import siteContent from '../data/siteContent.json';
const { about } = siteContent;
---

<section id="empresa" class="py-20 md:py-32 relative overflow-hidden bg-[#070b16] border-y border-white/[0.05]">
  
  <!-- Subtle ambient glow -->
  <div class="pointer-events-none absolute top-1/2 right-1/4 -translate-y-1/2 w-[500px] h-[350px] bg-[#0052FF]/10 rounded-full blur-[150px] -z-10"></div>
  <div class="pointer-events-none absolute bottom-10 left-1/4 w-[400px] h-[300px] bg-[#00F0FF]/10 rounded-full blur-[140px] -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header: Company Philosophy -->
    <div class="max-w-3xl mx-auto text-center mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1224] border border-[#0052FF]/30 text-xs font-mono-code text-[#00F0FF] mb-4">
        <span>●</span>
        <span>{about.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
        {about.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
        {about.subtitle}
      </p>
    </div>

    <!-- 4 Trust & Engineering Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {about.pillars.map((pillar, idx) => (
        <div class="p-6 rounded-2xl bg-[#0b1020]/90 border border-white/[0.07] hover:border-[#0052FF]/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(0,82,255,0.15)] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-8 h-8 rounded-lg bg-[#0052FF]/15 border border-[#0052FF]/30 text-[#00F0FF] text-xs font-mono-code flex items-center justify-center font-bold">
                0{idx + 1}
              </span>
              <span class="text-xs font-mono-code text-slate-400">{pillar.tag}</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2 tracking-tight">
              {pillar.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              {pillar.desc}
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-white/[0.05]">
            <span class="text-[11px] font-mono-code text-[#10B981] flex items-center gap-1.5">
              <span>✓</span> {pillar.guarantee}
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Banner / Company Credibility Bar -->
    <div class="max-w-5xl mx-auto rounded-3xl bg-[#090e1c] border border-white/[0.08] p-6 sm:p-8 backdrop-blur-md">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center justify-center">
        {about.stats.map((st, index) => (
          <div class={`flex flex-col items-center justify-center text-center px-4 py-2 w-full ${index !== 0 ? 'md:border-l md:border-white/[0.08]' : ''}`}>
            <span class="block text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white font-mono-code mb-1 text-gradient-cyan text-center">
              {st.value}
            </span>
            <span class="block text-xs sm:text-sm font-semibold text-slate-200 mb-0.5 text-center">
              {st.label}
            </span>
            <span class="block text-[11px] text-slate-400 font-mono-code text-center">
              {st.desc}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

