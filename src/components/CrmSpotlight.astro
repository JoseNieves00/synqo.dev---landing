---
import siteContent from '../data/siteContent.json';
const { crmFeature } = siteContent;
---

<section id="crm-ecosistema" class="py-20 md:py-28 relative overflow-hidden bg-[#070b16] border-y border-white/[0.05]">
  
  <!-- Subtle ambient glow -->
  <div class="pointer-events-none absolute top-1/2 left-1/4 -translate-y-1/2 w-[550px] h-[350px] bg-[#0052FF]/10 rounded-full blur-[140px] -z-10"></div>
  <div class="pointer-events-none absolute bottom-10 right-1/4 w-[400px] h-[300px] bg-[#00F0FF]/10 rounded-full blur-[130px] -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-14 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1224] border border-[#0052FF]/30 text-xs font-mono-code text-[#00F0FF] mb-4">
        <span class="w-2 h-2 rounded-full bg-[#00F0FF] animate-pulse"></span>
        <span>{crmFeature.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {crmFeature.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {crmFeature.subtitle}
      </p>
    </div>

    <!-- Main Grid: Architecture Highlights + Visual Panel -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left: 4 Minimalist Highlights -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
        {crmFeature.highlights.map((item, idx) => (
          <div class="p-5 rounded-2xl bg-[#0b1020]/90 border border-white/[0.07] hover:border-[#0052FF]/50 transition-all duration-300 hover:bg-[#0e162d]">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-xs font-mono-code text-[#00F0FF] px-2 py-0.5 rounded bg-[#00F0FF]/10 border border-[#00F0FF]/20">
                0{idx + 1}
              </span>
              <h3 class="text-base font-bold text-white tracking-tight">{item.title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-300/90 leading-relaxed pl-8">
              {item.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Right: Minimalist CRM Interface Mockup -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl bg-[#090e1c] border border-white/[0.1] p-6 sm:p-8 shadow-2xl relative overflow-hidden">
          
          <!-- Top system bar -->
          <div class="flex flex-wrap items-center justify-between gap-4 pb-5 border-b border-white/[0.08] mb-6">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#0052FF] flex items-center justify-center text-white text-xs font-bold shadow-[0_0_12px_rgba(0,82,255,0.6)]">
                SQ
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-white">Synqo CRM Core</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono-code bg-[#10B981]/15 text-[#10B981] border border-[#10B981]/30">
                    WABA OFICIAL
                  </span>
                </div>
                <span class="text-[11px] font-mono-code text-slate-400">Ambiente de Producción · Multi-agente</span>
              </div>
            </div>

            <div class="flex items-center gap-2 text-xs font-mono-code text-slate-300">
              <span class="inline-block w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
              <span>IA Activa: 0.2s</span>
            </div>
          </div>

          <!-- Kanban Simulation Preview (3 Columns Minimalist) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
            
            <!-- Col 1: Nuevos Leads (Atendidos por IA) -->
            <div class="rounded-xl bg-[#060913] border border-white/[0.06] p-3 space-y-2.5">
              <div class="flex items-center justify-between text-xs font-mono-code pb-1.5 border-b border-white/[0.05]">
                <span class="text-slate-400">1. Nuevos Leads</span>
                <span class="px-1.5 py-0.5 rounded bg-[#0052FF]/20 text-[#00F0FF] text-[10px]">3</span>
              </div>
              <div class="p-2.5 rounded-lg bg-[#0c1322] border border-[#0052FF]/30 text-xs space-y-1 shadow-sm">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-white">Dra. Valery M.</span>
                  <span class="text-[10px] text-[#10B981] font-mono-code">IA respondiendo</span>
                </div>
                <p class="text-[11px] text-slate-400 truncate">Consulta por software para 4 sedes...</p>
              </div>
              <div class="p-2.5 rounded-lg bg-[#0c1322] border border-white/[0.05] text-xs space-y-1">
                <span class="font-semibold text-white block">Estudio Legal Gómez</span>
                <p class="text-[11px] text-slate-400 truncate">Calificado · Ticket Alto</p>
              </div>
            </div>

            <!-- Col 2: Calificados / Listo para Asesor -->
            <div class="rounded-xl bg-[#060913] border border-white/[0.06] p-3 space-y-2.5">
              <div class="flex items-center justify-between text-xs font-mono-code pb-1.5 border-b border-white/[0.05]">
                <span class="text-slate-400">2. En Seguimiento</span>
                <span class="px-1.5 py-0.5 rounded bg-[#10B981]/20 text-[#10B981] text-[10px]">2</span>
              </div>
              <div class="p-2.5 rounded-lg bg-[#0c1322] border border-[#10B981]/40 text-xs space-y-1 shadow-[0_0_15px_rgba(16,185,129,0.15)]">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-white">Carlos Restrepo</span>
                  <span class="text-[10px] text-[#00F0FF] font-mono-code">Asignado</span>
                </div>
                <p class="text-[11px] text-slate-400 truncate">Solicitó propuesta Combo Pro...</p>
              </div>
              <div class="p-2.5 rounded-lg bg-[#0c1322] border border-white/[0.05] text-xs space-y-1">
                <span class="font-semibold text-white block">Arq. Mariana Silva</span>
                <p class="text-[11px] text-slate-400 truncate">Demo agendada 3:00 PM</p>
              </div>
            </div>

            <!-- Col 3: Cierre & Facturación -->
            <div class="rounded-xl bg-[#060913] border border-white/[0.06] p-3 space-y-2.5">
              <div class="flex items-center justify-between text-xs font-mono-code pb-1.5 border-b border-white/[0.05]">
                <span class="text-slate-400">3. Cierres</span>
                <span class="px-1.5 py-0.5 rounded bg-white/10 text-white text-[10px]">4</span>
              </div>
              <div class="p-2.5 rounded-lg bg-[#0c1322] border border-white/[0.08] text-xs space-y-1">
                <span class="font-semibold text-[#10B981] block">✓ TechSolutions SAS</span>
                <p class="text-[11px] text-slate-400 truncate">Onboarding iniciado</p>
              </div>
              <div class="p-2.5 rounded-lg bg-[#0c1322] border border-white/[0.08] text-xs space-y-1">
                <span class="font-semibold text-[#10B981] block">✓ Dental Premium</span>
                <p class="text-[11px] text-slate-400 truncate">Setup WABA completado</p>
              </div>
            </div>

          </div>

          <!-- Bottom Status Bar -->
          <div class="pt-4 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4 text-xs font-mono-code text-slate-400">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span> Cero fuga de leads
              </span>
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#00F0FF]"></span> Trazabilidad total
              </span>
            </div>
            <a 
              href="#servicios" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-white bg-[#0052FF] hover:bg-[#0041cb] transition-all"
            >
              <span>Ver Planes de CRM</span>
              <span>→</span>
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
