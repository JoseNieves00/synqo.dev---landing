---
import siteContent from '../data/siteContent.json';
const { services } = siteContent;
---

<section id="servicios" class="py-20 md:py-32 relative overflow-hidden">
  
  <!-- Ambient background glow for featured card -->
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[450px] bg-[#0052FF]/12 rounded-full blur-[150px] -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1224] border border-[#0052FF]/30 text-xs font-mono-code text-[#00F0FF] mb-4">
        <span>★</span>
        <span>{services.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {services.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300/90 leading-relaxed">
        {services.subtitle}
      </p>
    </div>

    <!-- 3 Services Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {services.items.map((svc) => (
        <div class={`rounded-3xl flex flex-col justify-between transition-all duration-300 relative ${
          svc.featured 
            ? 'bg-[#0d1527] border-2 border-[#0052FF] shadow-[0_0_50px_rgba(0,82,255,0.3)] lg:-translate-y-4 p-8' 
            : 'bg-[#090e1c]/80 border border-white/[0.08] hover:border-white/20 p-7'
        }`}>
          
          {svc.featured && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-[#0052FF] to-[#00F0FF] text-[11px] font-mono-code font-bold text-white shadow-md uppercase tracking-wider flex items-center gap-1.5">
              <span>⚡</span> {svc.tag}
            </div>
          )}

          <div>
            <!-- Card Header -->
            <div class="mb-6">
              {!svc.featured && (
                <span class="inline-block px-2.5 py-1 rounded-md bg-[#0052FF]/15 border border-[#0052FF]/30 text-[#00F0FF] text-[11px] font-mono-code font-semibold mb-3">
                  {svc.tag}
                </span>
              )}
              <h3 class={`text-xl sm:text-2xl font-bold text-white ${svc.featured ? 'mt-2' : ''}`}>
                {svc.name}
              </h3>
            </div>

            <!-- Description -->
            <p class="text-sm text-slate-300 leading-relaxed mb-8">
              {svc.description}
            </p>

            <!-- Features Included List -->
            <div class="space-y-3 pt-4 border-t border-white/[0.06] mb-8">
              <span class="text-xs font-mono-code uppercase tracking-wider text-slate-400 block mb-2">
                ¿Qué incluye?
              </span>
              {svc.includes.map((feature) => (
                <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-200">
                  <span class={`mt-0.5 flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold ${
                    svc.featured 
                      ? 'bg-[#00F0FF]/20 text-[#00F0FF]' 
                      : 'bg-[#0052FF]/20 text-[#0052FF]'
                  }`}>
                    ✓
                  </span>
                  <span>{feature}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom CTA Button -->
          <div class="pt-4 border-t border-white/[0.06]">
            <a 
              href="#diagnostico" 
              class={`w-full py-3.5 rounded-xl text-center text-sm font-bold block transition-all duration-200 ${
                svc.featured
                  ? 'bg-[#0052FF] hover:bg-[#0041cb] text-white shadow-[0_0_25px_rgba(0,82,255,0.5)] hover:shadow-[0_0_35px_rgba(0,82,255,0.7)]'
                  : 'bg-white/5 hover:bg-white/10 text-white border border-white/10 hover:border-white/20'
              }`}
            >
              {svc.cta}
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
